{
  "manifest_version": 3,
  "name": "BOOTH Free Collector",
  "version": "2.5.0",
  "minimum_chrome_version": "116",
  "description": "12時間ごとの無料商品取得。拡張単体・Windows連携に対応。認証はブラウザ内のみ。",
  "key": "",
  "permissions": [
    "storage",
    "alarms",
    "downloads",
    "offscreen",
    "nativeMessaging",
    "notifications",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://booth.pm/*",
    "https://*.booth.pm/*",
    "https://booth.pximg.net/*",
    "https://booth-free-collector.vrc-ranking-board.workers.dev/*"
  ],
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "action": {
    "default_popup": "options.html",
    "default_title": "BOOTH Free Collector"
  },
  "options_page": "options.html",
  "icons": {
    "128": "icon.png"
  }
}
